{
  "name": "@tessera/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "generate": "node --import tsx node_modules/drizzle-kit/bin.cjs generate",
    "migrate": "tsx src/migrate.ts",
    "studio": "node --import tsx node_modules/drizzle-kit/bin.cjs studio",
    "seed": "tsx src/seed.ts",
    "lint": "eslint src drizzle.config.ts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo drizzle"
  },
  "dependencies": {
    "@tessera/shared": "workspace:*",
    "argon2": "0.41.1",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.5"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "dotenv": "16.4.7",
    "drizzle-kit": "0.28.1",
    "rimraf": "6.0.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
