{
  "name": "@tessera/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:workers": "tsx watch src/workers.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:workers": "node dist/workers.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings 0",
    "clean": "rimraf dist .turbo coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1129.0",
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "13.0.0",
    "@fastify/jwt": "10.2.2",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "10.2.1",
    "@fastify/sensible": "6.0.1",
    "@fastify/swagger": "9.2.0",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/under-pressure": "9.0.1",
    "@tessera/contracts": "workspace:*",
    "@tessera/db": "workspace:*",
    "@tessera/shared": "workspace:*",
    "argon2": "0.41.1",
    "bullmq": "5.34.2",
    "close-with-grace": "2.2.0",
    "dotenv": "16.4.7",
    "envalid": "8.0.0",
    "fastify": "5.12.3",
    "fastify-plugin": "5.0.1",
    "fastify-raw-body": "5.0.0",
    "fastify-type-provider-zod": "4.0.2",
    "ioredis": "5.4.1",
    "nanoid": "5.0.9",
    "pino": "9.5.0",
    "pino-pretty": "13.0.0",
    "qrcode": "1.5.4",
    "redlock": "5.0.0-beta.2",
    "resend": "4.0.1",
    "sharp": "0.35.4",
    "viem": "2.21.54",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/qrcode": "1.5.5",
    "rimraf": "6.0.1",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
