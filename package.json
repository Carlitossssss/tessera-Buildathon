{
  "name": "tessera",
  "version": "0.1.0",
  "private": true,
  "description": "Tessera monorepo - SaaS de certificados educativos SBT sobre Polygon",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel --no-daemon",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "db:generate": "pnpm --filter @tessera/db generate",
    "db:migrate": "pnpm --filter @tessera/db migrate",
    "db:seed": "pnpm --filter @tessera/db seed",
    "db:studio": "pnpm --filter @tessera/db studio",
    "api:dev": "pnpm --filter @tessera/api dev",
    "api:start": "pnpm --filter @tessera/api start",
    "workers:dev": "pnpm --filter @tessera/api dev:workers",
    "clean": "turbo run clean && rimraf node_modules",
    "prepare": "husky || true"
  },

  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.9.0",
    "eslint": "9.17.0",
    "globals": "14.0.0",
    "husky": "9.1.7",
    "lint-staged": "15.2.10",
    "prettier": "3.3.3",
    "rimraf": "6.0.1",
    "turbo": "2.3.3",
    "typescript": "5.7.2",
    "typescript-eslint": "8.59.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
