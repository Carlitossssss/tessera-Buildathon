# ==========================================
# Tessera - Variables de entorno
# ==========================================

# Runtime
NODE_ENV=development
LOG_LEVEL=debug

# API
API_PORT=3001
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:3001
API_CORS_ORIGINS=http://localhost:3000

# Auth (Auth.js v5 - compartido entre web y api)
AUTH_SECRET=change-me-in-production-minimum-32-chars
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
INSTITUTION_DOCS_REQUIRE_AUTH=false
JWT_EXPIRES_IN=4h
REFRESH_TOKEN_EXPIRES_IN=30d

# OAuth opcional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web (Next.js - apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_POLYGON_CHAIN_ID=80002
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
NEXT_PUBLIC_CONTRACT_REGISTRY=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_CONTRACT_CERTIFICATE=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_CONTRACT_BADGE=0x0000000000000000000000000000000000000000

# PostgreSQL
DATABASE_URL=postgres://tessera:tessera@localhost:5432/tessera
DATABASE_POOL_MAX=20

# Redis
REDIS_URL=redis://localhost:6379

# Blockchain (Polygon)
POLYGON_CHAIN=polygonAmoy
POLYGON_CHAIN_ID=80002
POLYGON_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
POLYGON_RPC_URL_FALLBACK=https://polygon-amoy-bor-rpc.publicnode.com

# Contract addresses (post-deploy)
CONTRACT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
CONTRACT_CERTIFICATE_ADDRESS=0x0000000000000000000000000000000000000000
CONTRACT_BADGE_ADDRESS=0x0000000000000000000000000000000000000000
CONTRACT_AUTO_ISSUER_ADDRESS=0x0000000000000000000000000000000000000000

# Web3Signer + OpenBao (signer de producción)
# El API y los workers hablan con Web3Signer. Solo Web3Signer recibe un token
# OpenBao de lectura; nunca uses el root token. Ver docs/deploy.md.
WEB3SIGNER_URL=http://localhost:9000
OPENBAO_URL=
OPENBAO_TOKEN=
OPENBAO_SIGNING_KEY_PATH=secret/data/tessera/signer
OPENBAO_SIGNING_KEY_FIELD=value
BACKEND_SIGNER_ADDRESS=0x0000000000000000000000000000000000000000

# Llave privada del signer de plataforma. SOLO para desarrollo local.
#
# Las claves por defecto de Anvil y Hardhat (la que empieza por ac0974be... y
# las otras nueve del mismo juego) son PUBLICAS: estan en su documentacion y
# las conoce todo el mundo. Sirven para una cadena local efimera; cualquiera
# puede firmar con ellas, asi que no deben tocar una red real ni custodiar
# fondos. La API avisa en el arranque y en /v1/health si detecta una.
#
# Ademas, esta wallet es la que aprueba instituciones on-chain, asi que tiene
# que ser la OWNER de TesseraRegistry. Si no lo es, la aprobacion falla con
# "El signer de Tessera (0x...) no controla TesseraRegistry".
#
# En produccion no se usa: alli la clave vive en OpenBao y Web3Signer firma sin
# que la API llegue a verla.
SIGNER_PRIVATE_KEY=

# Storage - Arweave
ARWEAVE_JWK_JSON=
ARWEAVE_GATEWAY=https://arweave.net

# Storage - IPFS (Pinata)
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud
# Activalo solo cuando el gateway dedicado tenga cuota disponible y responda 200 sin auth.
IPFS_PUBLIC_GATEWAY=https://ipfs.io
PINATA_DEDICATED_GATEWAY=https://tomato-secondary-toad-829.mypinata.cloud
IPFS_FALLBACK_GATEWAYS=https://dweb.link,https://ipfs.io,https://w3s.link
IPFS_READINESS_TIMEOUT_SECONDS=45
IPFS_REQUEST_TIMEOUT_MS=15000
IPFS_POLL_INTERVAL_MS=3000

# Storage de objetos - MinIO en Fase 1
# La aplicación actual publica metadata final en Arweave/IPFS. Este bloque
# reserva la conexión S3 para plantillas e imágenes cuando se active el cliente.
OBJECT_STORAGE_PROVIDER=minio
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=tessera-assets
S3_PUBLIC_URL=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM="Tessera <info@blokislabs.com>"
EMAIL_REPLY_TO=info@blokislabs.com

# Stripe Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ENVIRONMENT=sandbox
STRIPE_PRICE_ESSENTIAL_MONTHLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_INSTITUTIONAL_MONTHLY=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_PACKAGE_200=
STRIPE_PRICE_PACKAGE_500=
STRIPE_PRICE_PACKAGE_1000=
STRIPE_PRICE_PACKAGE_2000=

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=tessera-api

# Rate limits (requests per minute)
RATE_LIMIT_STARTER=100
RATE_LIMIT_PRO=1000
RATE_LIMIT_PRO_EXTENDED=2500

# Webhooks
WEBHOOK_MAX_ATTEMPTS=7
WEBHOOK_TTL_DAYS=7

# Misc
SIGNED_URL_TTL_SECONDS=604800
GDPR_DELETION_GRACE_DAYS=30

# =============================================================================
# Unlock Protocol - Portal token-gated
# =============================================================================
# Crear el Lock en https://app.unlock-protocol.com con la wallet conectada a
# Ethereum Sepolia (chainId 11155111). Opcion "Deploy a custom membership".
# Recomendado: precio > 0 y duracion finita, para que la expiracion se note.
#
# Son solo la sugerencia del panel: cada contenido guarda su propio lock, asi
# que el portal funciona aunque falten.
UNLOCK_DEFAULT_LOCK_ADDRESS=
UNLOCK_DEFAULT_CHAIN_ID=11155111

# Opcional: vacio = RPC publicos de cada red soportada.
UNLOCK_RPC_URL=

NEXT_PUBLIC_UNLOCK_LOCK_ADDRESS=
NEXT_PUBLIC_UNLOCK_CHAIN_ID=11155111
